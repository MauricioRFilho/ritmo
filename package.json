{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "node scripts/clean-dist.mjs && cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --rule react-hooks/set-state-in-effect:off --rule react-hooks/purity:off",
    "test:python": "node scripts/python-check.mjs",
    "check": "npm run lint && npm run test:python && npm test",
    "test:db": "supabase test db",
    "check:release": "npm run check && npm run test:db",
    "validate:creative-models": "node scripts/validate-creative-models.mjs",
    "promote:community": "node scripts/promote-community-template.mjs"
  },
  "dependencies": {
    "@rolldown/pluginutils": "1.0.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "cross-env": "^10.1.0",
    "lucide-react": "^1.26.0",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tinyglobby": "0.2.15"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.47.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.12",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "^8.1.5",
    "wrangler": "^4.102.0"
  },
  "type": "module",
  "overrides": {
    "postcss": "8.5.18",
    "sharp": "0.35.0"
  }
}
